{
  "manifest_version": 3,
  "name": "Gamepad Spatial Navigation",
  "version": "0.2.0",
  "description": "Navigate any web page with a controller: D-pad moves focus between elements, A clicks, B goes back.",
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gamepad-spatial-nav@local"
    }
  }
}
